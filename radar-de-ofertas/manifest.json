{
  "manifest_version": 3,
  "name": "Radar de Ofertas",
  "version": "0.3.0",
  "description": "Busca, compara e classifica ofertas do Mercado Livre com histórico local de preços.",
  "action": {
    "default_popup": "app.html",
    "default_title": "Radar de Ofertas",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "scripting"],
  "host_permissions": [
    "https://api.mercadolibre.com/*",
    "https://lista.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://*.mlstatic.com data:"
  }
}
