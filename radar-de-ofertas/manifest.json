{
  "manifest_version": 3,
  "name": "Radar de Ofertas",
  "version": "0.6.2",
  "description": "Caçador automático de promoções: descobre ofertas reais do Mercado Livre por categoria, pontua as oportunidades e gera textos para grupos de promoções.",
  "action": {
    "default_title": "Abrir o Radar de Ofertas",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://api.mercadolibre.com/*",
    "https://lista.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://*.mlstatic.com data:"
  }
}
