# Supabase — obtenha esses valores no painel do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada apenas em rotas de servidor/admin, nunca exposta ao navegador
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site (usada em SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://pancpedia.com.br

# Mapa de Itamira (/mapa) — URL de incorporação de um mapa do Google My Maps
# publicado pela equipe do projeto (Google My Maps → Compartilhar → Incorporar
# no meu site → copiar o src do iframe). Sem essa variável, a página do mapa
# mostra um aviso em vez de quebrar.
NEXT_PUBLIC_GOOGLE_MY_MAPS_EMBED_URL=https://www.google.com/maps/d/embed?mid=SEU_MAP_ID
